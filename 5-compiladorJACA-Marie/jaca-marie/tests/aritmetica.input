# Todos os operadores aritméticos, com sinais
print(7 + 3);
print(7 - 10);
print(7 * 3);
print(-7 * 3);
print(7 * -3);
print(-7 * -3);
print(0 * 5);
print(7 / 2);
print(-7 / 2);
print(7 / -2);
print(-7 / -2);
print(7 % 3);
print(-7 % 3);
print(7 % -3);
print(-7 % -3);
print(2 + 3 * 4);
print((2 + 3) * 4);
print(100 / 5 / 2);
print(-(3 + 4));
print(--5);
print(10 - 2 - 3);
print(2 * (3 + 4) * (5 - 1));
print(100 - (30 - (20 - (10 - 5))));