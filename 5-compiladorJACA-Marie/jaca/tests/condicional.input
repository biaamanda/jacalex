# if, else e if aninhado com cada operador relacional
x = 10;
if (x > 5) then { print(1); } else { print(0); }
if (x < 5) then { print(1); } else { print(0); }
if (x >= 10) then { print(1); } else { print(0); }
if (x <= 9) then { print(1); } else { print(0); }
if (x == 10) then { print(1); } else { print(0); }
if (x != 10) then { print(1); } else { print(0); }
if (x != 7) then { print(2); }
if (x == 7) then { print(3); }
if (x > 0) then {
    if (x > 20) then { print(4); } else { print(5); }
    print(6);
}