# while: soma de 1 a 10, fatorial de 5, mdc e laços aninhados
i = 1;
soma = 0;
while (i <= 10) {
    soma = soma + i;
    i = i + 1;
}
print(soma);

n = 5;
fat = 1;
while (n > 1) {
    fat = fat * n;
    n = n - 1;
}
print(fat);

a = 48;
b = 18;
while (b != 0) {
    t = a % b;
    a = b;
    b = t;
}
print(a);

i = 1;
while (i <= 3) {
    j = 1;
    while (j <= 3) {
        print(i * j);
        j = j + 1;
    }
    i = i + 1;
}