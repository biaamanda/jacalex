package parser;

import java_cup.runtime.*;
import java.util.*;

action code {:
    private final Stack<HashMap<String, Value>> tableStack = new Stack<>();

    {
        tableStack.push(new HashMap<>());
    }

    private void pushScope() {
        tableStack.push(new HashMap<>());
    }

    private void popScope() {
        tableStack.pop();
    }

    private void assign(String name, Value value) {
        tableStack.peek().put(name, value);
    }

    private Value lookup(String name) {
        ListIterator<HashMap<String, Value>> it = tableStack.listIterator(tableStack.size());
        while (it.hasPrevious()) {
            HashMap<String, Value> table = it.previous();
            if (table.containsKey(name)) {
                return table.get(name);
            }
        }
        throw new RuntimeException("Variável não definida: " + name);
    }
:}

parser code {:
    public void syntax_error(Symbol token) {
        String found = token.value == null ? "fim da entrada" : "\"" + token.value + "\"";
        throw new RuntimeException("Erro durante a análise sintática: marca inesperada " + found + "\n" +
                "Linha: " + (token.left + 1) + " e Coluna: " + (token.right + 1));
    }
:}

terminal PRINT, SIN, COS, PI;
terminal ASSIGN, SEMI, LPAREN, RPAREN, LBRACE, RBRACE;
terminal PLUS, MINUS, TIMES, DIVIDE, MOD, POWER, UMINUS;
terminal Double NUMBER;
terminal String ID, STRING;

non terminal program, command_list, command_part, command_block;
non terminal command, assignment_command, print_command;
non terminal Value expr;

precedence left PLUS, MINUS;
precedence left TIMES, DIVIDE, MOD;
precedence right UMINUS;
precedence right POWER;

start with program;

program ::= command_list
    ;

command_list ::= command_list command_part
    | command_part
    ;

command_part ::= command SEMI
    | command_block
    ;

command_block ::= LBRACE {: pushScope(); :} command_list RBRACE {: popScope(); :}
    ;

command ::= assignment_command
    | print_command
    ;

assignment_command ::= ID:id ASSIGN expr:e
        {: assign(id, e); :}
    ;

print_command ::= PRINT LPAREN expr:e RPAREN
        {: System.out.println(">> " + e); :}
    ;

expr ::= expr:e1 PLUS expr:e2
        {: RESULT = Operations.add(e1, e2); :}
    | expr:e1 MINUS expr:e2
        {: RESULT = Operations.subtract(e1, e2); :}
    | expr:e1 TIMES expr:e2
        {: RESULT = Operations.multiply(e1, e2); :}
    | expr:e1 DIVIDE expr:e2
        {: RESULT = Operations.divide(e1, e2); :}
    | expr:e1 MOD expr:e2
        {: RESULT = Operations.mod(e1, e2); :}
    | expr:e1 POWER expr:e2
        {: RESULT = Operations.power(e1, e2); :}
    | MINUS expr:e
        {: RESULT = Operations.negate(e); :} %prec UMINUS
    | LPAREN expr:e RPAREN
        {: RESULT = e; :}
    | NUMBER:n
        {: RESULT = new Value(n); :}
    | STRING:s
        {: RESULT = new Value(s); :}
    | ID:id
        {: RESULT = lookup(id); :}
    | SIN LPAREN expr:e RPAREN
        {: RESULT = Operations.sin(e); :}
    | COS LPAREN expr:e RPAREN
        {: RESULT = Operations.cos(e); :}
    | PI
        {: RESULT = new Value(Math.PI); :}
    ;
